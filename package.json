{
  "name": "vedaai-monorepo",
  "private": true,
  "scripts": {
    "frontend": "cd apps/frontend && npm run dev",

    "backend": "cd apps/backend && npm run dev",

    "worker": "cd apps/backend && npm run worker",

    "dev": "concurrently \"npm run frontend\" \"npm run backend\" \"npm run worker\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}